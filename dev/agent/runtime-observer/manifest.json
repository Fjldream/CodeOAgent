{
  "manifest_version": 3,
  "name": "KF 运行画面核对",
  "version": "0.1.0",
  "description": "单击后，仅向本机 KF 开发助手提供当前运行标签页中选定控件的观察。",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "将此 KF 运行页关联到本机开发助手，再次单击解除"
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  }
}
