# modified by jinlong.feng at 2026-11-20 KF开发助手M1
KF_CENTER_ORIGIN=
# 自签名 Center 可配置 PEM CA 或预先核验的叶证书 SHA-256。
KF_CENTER_CA=
KF_CENTER_CERT_SHA256=
KF_AGENT_PORT=43170
# 未配置模型时，提供真实 KF 已保存字段查询。启用模型须配置专用端点、模型、密钥及显式开关。
KF_AGENT_ENABLE_MODEL=false
KF_MODEL_BASE_URL=
KF_MODEL_ID=
KF_MODEL_API_KEY=
# 可覆盖默认本包安装的 OpenCode 1.19.6。
KF_OPENCODE_BINARY=
# end

# modified by jinlong.feng at 2026-11-21 KF采样与报警事件联查
# 数采源时间没有时区时，填现场已核实的 UTC 偏移，例如 +08:00。
KF_AGENT_SOURCE_UTC_OFFSET=
# end
